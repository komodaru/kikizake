import Kikizake.Mirror
/-! GDI+'s pixel format conversions (spec/gdiplus.txt GP.CONV.*), as src/model/gdiplus.rs computes
them: `toArgb` is `gdiplus::to_argb`, `fromArgb` is `gdiplus::from_argb` for every format but the
indexed ones and 16bppGrayScale (mirrors `gp.to_argb`, `gp.from_argb`, `gp.premultiply`,
`gp.unpremultiply`). The sRGB curve's values (`WIDEN`, `NARROW`) are the model's own f64 results
as tables, held equal by the mirrors `gp.widen` and `gp.narrow` over every level; the theorems
are about those tables. -/
namespace Kikizake.GdiPlus.Conv

/-- 5 and 6 bit channels to 8 by repeating their high bits (GP.CONV.EXPAND) -/
def x5 (v : Nat) : Nat := (v * 8 + v / 4) % 256
def x6 (v : Nat) : Nat := (v * 4 + v / 16) % 256

/-- GP.CONV.EXPAND, GP.CONV.TRUNCATE: truncating an expanded channel gives it back, and the
expansion keeps black and white -/
theorem expand_truncate : (∀ v : Fin 32, x5 v.val / 8 = v.val) ∧ (∀ v : Fin 64, x6 v.val / 4 = v.val) ∧
    x5 0 = 0 ∧ x5 31 = 255 ∧ x6 0 = 0 ∧ x6 63 = 255 := by decide

/-- GP.CONV.EXPAND: the expansion is within one 8-bit level of v 255 / 31 (and v 255 / 63), and
grows with v -/
theorem expand_close : (∀ v : Fin 32, x5 v.val * 31 ≤ v.val * 255 + 31 ∧ v.val * 255 ≤ x5 v.val * 31 + 31) ∧
    (∀ v : Fin 64, x6 v.val * 63 ≤ v.val * 255 + 63 ∧ v.val * 255 ≤ x6 v.val * 63 + 63) ∧
    (∀ v : Fin 31, x5 v.val < x5 (v.val + 1)) ∧ (∀ v : Fin 63, x6 v.val < x6 (v.val + 1)) := by decide

/-- GP.CONV.PREMULTIPLY -/
def premultiply (c a : Nat) : Nat := (c * a + 127) / 255

/-- GP.CONV.PREMULTIPLY: c a / 255 to the nearest integer (255 odd: no halves), never above the
alpha -/
theorem premultiply_nearest (c a : Nat) (hc : c ≤ 255) :
    255 * premultiply c a ≤ c * a + 127 ∧ c * a ≤ 255 * premultiply c a + 127 ∧ premultiply c a ≤ a := by
  unfold premultiply
  have : c * a ≤ 255 * a := Nat.mul_le_mul_right a hc
  refine ⟨by omega, by omega, by omega⟩

/-- GP.CONV.UNPREMULTIPLY: a 16.16 reciprocal of the alpha, truncated, the product truncated, at
most 255; alpha 0 keeps the color -/
def unpremultiply (c a : Nat) : Nat := if a = 0 then c else min 255 (c * (16711680 / a) / 65536)

theorem unpremultiply_le (c a : Nat) (ha : 0 < a) : unpremultiply c a ≤ 255 := by
  unfold unpremultiply; simp only [Nat.pos_iff_ne_zero.mp ha, ite_false]; exact Nat.min_le_left _ _

/-- GP.CONV.PREMULTIPLY, UNPREMULTIPLY: an opaque color goes through premultiplied unchanged -/
theorem opaque_round_trip (c : Nat) (hc : c ≤ 255) : unpremultiply (premultiply c 255) 255 = c := by
  unfold unpremultiply premultiply; simp only [Nat.reduceEqDiff, ite_false, Nat.reduceDiv]
  have : (c * 255 + 127) / 255 = c := by omega
  rw [this]; omega

/-- GP.CONV.UNPREMULTIPLY: undoing premultiplication loses at most what the rounding lost: the
color comes back within 255 / a (from below or one above) -/
theorem unpremultiply_close (c a : Nat) (ha : 0 < a) :
    unpremultiply c a * a ≤ c * 255 + a := by
  unfold unpremultiply; simp only [Nat.pos_iff_ne_zero.mp ha, ite_false]
  have r1 := Nat.div_mul_le_self 16711680 a
  have r2 := Nat.div_mul_le_self (c * (16711680 / a)) 65536
  have : c * (16711680 / a) / 65536 * a ≤ c * 255 + a := by
    have m : c * (16711680 / a) / 65536 * 65536 * a ≤ c * (16711680 / a) * a := Nat.mul_le_mul_right a r2
    have m2 : c * (16711680 / a) * a ≤ c * 16711680 := by rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left c r1
    have : c * (16711680 / a) / 65536 * a * 65536 ≤ c * 255 * 65536 := by grind
    exact Nat.le_trans (Nat.le_of_mul_le_mul_right this (by decide : 0 < 65536)) (Nat.le_add_right _ _)
  exact Nat.le_trans (Nat.mul_le_mul_right a (Nat.min_le_right _ _)) this

