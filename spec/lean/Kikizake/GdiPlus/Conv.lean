def widen (c : Nat) : Nat := WIDEN.getD c 0

/-- a 16-bit channel as a signed number, clamped to 0..8192 -/
def level (v : Nat) : Nat := if v % 65536 ≥ 32768 then 0 else min (v % 65536) 8192
def narrow (v : Nat) : Nat := (NARROW.getD (level v / 256) #[]).getD (level v % 256) 0

/-- alpha: a 8192 / 255 truncated, and back -/
def widenAlpha (a : Nat) : Nat := a * 8192 / 255
def narrowAlpha (a : Nat) : Nat := level a * 255 / 8192

/-- GP.CONV.WIDEN, GP.CONV.NARROW: black is 0, white 8192, every level apart and growing, and every
8-bit channel comes back from 16 bits unchanged -/
theorem widen_narrow : WIDEN.size = 256 ∧ NARROW.size = 33 ∧ widen 0 = 0 ∧ widen 255 = 8192 ∧
    (∀ c : Fin 255, widen c.val < widen (c.val + 1)) ∧ (∀ c : Fin 256, narrow (widen c.val) = c.val) := by
  decide +kernel

/-- GP.CONV.NARROW: words from 0x8000 (negative) are 0, past 8192 are 8192 -/
theorem level_clamps (v : Nat) : level v ≤ 8192 ∧ (v % 65536 ≥ 32768 → level v = 0) := by
  unfold level; constructor <;> (try intro) <;> split <;> omega

/-- GP.CONV.WIDEN, NARROW: alpha to 16 bits and back loses one level, both truncations rounding
down, except for 0 and 255, which come back -/
theorem alpha_round_trip (a : Nat) (h : a ≤ 255) :
    narrowAlpha (widenAlpha a) = if a = 0 ∨ a = 255 then a else a - 1 := by
  unfold narrowAlpha widenAlpha level
  have : a * 8192 / 255 % 65536 = a * 8192 / 255 := by omega
  rw [this]
  simp only [show ¬ (a * 8192 / 255 ≥ 32768) by omega, ite_false, Nat.min_eq_left (show a * 8192 / 255 ≤ 8192 by omega)]
  split <;> omega

def byte (v s : Nat) : Nat := v / 2 ^ s % 256
def bits (v s w : Nat) : Nat := v / 2 ^ s % 2 ^ w
def argb (a r g b : Nat) : Nat := a * 16777216 + r * 65536 + g * 256 + b
def signed16 (v : Nat) : Int := let w := v % 65536; if w ≥ 32768 then (w : Int) - 65536 else w

/-- the formats, in the order of `gdiplus::Pf` -/
inductive Pf | i1 | i4 | i8 | gray16 | rgb555 | rgb565 | argb1555 | rgb24 | rgb32 | argb32 | pargb32 | rgb48 | argb64 | pargb64

def pf : Nat → Option Pf
  | 4 => some .rgb555 | 5 => some .rgb565 | 6 => some .argb1555 | 7 => some .rgb24 | 8 => some .rgb32
  | 9 => some .argb32 | 10 => some .pargb32 | 11 => some .rgb48 | 12 => some .argb64 | 13 => some .pargb64
  | _ => none

/-- a premultiplied 16-bit word undone: c 8192 / a in 32 bits truncated toward 0, kept to 16 bits -/
def undo16 (c : Nat) (a : Nat) : Nat := if a = 0 then c else ((signed16 c * 8192).tdiv a % 65536).toNat

/-- GP.CONV.EXPAND, OPAQUE, UNPREMULTIPLY, NARROW, NARROW.PREMULTIPLIED: a pixel value as straight ARGB -/
def toArgb : Pf → Nat → Option Nat
  | .rgb555, v => some (argb 255 (x5 (bits v 10 5)) (x5 (bits v 5 5)) (x5 (bits v 0 5)))
  | .rgb565, v => some (argb 255 (x5 (bits v 11 5)) (x6 (bits v 5 6)) (x5 (bits v 0 5)))
  | .argb1555, v => some (argb (if bits v 15 1 = 1 then 255 else 0) (x5 (bits v 10 5)) (x5 (bits v 5 5)) (x5 (bits v 0 5)))
  | .rgb24, v | .rgb32, v => some (argb 255 (byte v 16) (byte v 8) (byte v 0))
  | .argb32, v => some (v % 4294967296)
  | .pargb32, v => let a := byte v 24
      some (argb a (unpremultiply (byte v 16) a) (unpremultiply (byte v 8) a) (unpremultiply (byte v 0) a))
  | .rgb48, v => some (argb 255 (narrow (bits v 32 16)) (narrow (bits v 16 16)) (narrow (bits v 0 16)))
  | .argb64, v => some (argb (narrowAlpha (bits v 48 16)) (narrow (bits v 32 16)) (narrow (bits v 16 16)) (narrow (bits v 0 16)))
  | .pargb64, v => let a := level (bits v 48 16)
      some (argb (narrowAlpha a) (narrow (undo16 (bits v 32 16) a)) (narrow (undo16 (bits v 16 16) a)) (narrow (undo16 (bits v 0 16) a)))
  | _, _ => none

/-- GP.CONV.TRUNCATE, OPAQUE, KEEP, PREMULTIPLY, WIDEN, WIDEN.PREMULTIPLIED: straight ARGB as a
pixel value -/
def fromArgb (f : Pf) (c : Nat) : Option Nat :=
  let (a, r, g, b) := (byte c 24, byte c 16, byte c 8, byte c 0)
  match f with
  | .rgb555 => some ((r / 8) * 1024 + (g / 8) * 32 + b / 8)
  | .rgb565 => some ((r / 8) * 2048 + (g / 4) * 32 + b / 8)
  | .argb1555 => some ((a / 128) * 32768 + (r / 8) * 1024 + (g / 8) * 32 + b / 8)
  | .rgb24 => some (c % 16777216)
  | .rgb32 | .argb32 => some (c % 4294967296)
  | .pargb32 => some (argb a (premultiply r a) (premultiply g a) (premultiply b a))
  | .rgb48 => some (widen r * 4294967296 + widen g * 65536 + widen b)
  | .argb64 => some (widenAlpha a * 281474976710656 + widen r * 4294967296 + widen g * 65536 + widen b)
  | .pargb64 => let a16 := widenAlpha a
      let p := fun c => widen c * a16 / 8192
      some (a16 * 281474976710656 + p r * 4294967296 + p g * 65536 + p b)
  | _ => none

/-- GP.CONV.OPAQUE, KEEP: 32bppRGB keeps the alpha byte, 24bppRGB drops it, both read opaque -/
theorem rgb32_keeps (c : Nat) (h : c < 4294967296) : fromArgb .rgb32 c = some c ∧
    (toArgb .rgb24 c).map (· % 16777216) = some (c % 16777216) ∧ ((toArgb .rgb32 c).map (byte · 24)) = some 255 := by
  simp only [fromArgb, toArgb, Nat.mod_eq_of_lt h, Option.map, argb, byte, Option.some.injEq]
  refine ⟨trivial, by omega, by omega⟩

def mirrors : List Mirror := [
  ⟨"gp.premultiply", fun | [c, a] => do pure [premultiply (← nat c) (← nat a)] | _ => none⟩,
  ⟨"gp.unpremultiply", fun | [c, a] => do pure [unpremultiply (← nat c) (← nat a)] | _ => none⟩,
  ⟨"gp.widen", fun | [c] => do let c ← nat c; if c < 256 then pure [widen c] else none | _ => none⟩,
  ⟨"gp.narrow", fun | [v] => do pure [narrow (← nat v)] | _ => none⟩,
  ⟨"gp.to_argb", fun | [f, v] => do pure [← toArgb (← pf (← nat f)) (← nat v)] | _ => none⟩,
  ⟨"gp.from_argb", fun | [f, c] => do pure [← fromArgb (← pf (← nat f)) (← nat c)] | _ => none⟩
]

end Kikizake.GdiPlus.Conv
